{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "controller_name": { "type": "string" },
    "updated_at": { "type": "string" },
    "mapping": {
      "type": "object",
      "patternProperties": {
        ".*": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["button", "axis", "hat"] },
              "index": { "type": "integer", "description": "Button/Axis/Hat ID" },
              "value": { 
                "type": "array", 
                "items": { "type": "integer" },
                "description": "For hats: [x, y] coordinates"
              },
              "direction": { "type": "string", "enum": ["positive", "negative"] },
              "threshold": { "type": "number" }
            },
            "required": ["type", "index"]
          }
        }
      }
    }
  },
  "required": ["mapping"]
}
