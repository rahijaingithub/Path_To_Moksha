{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "patternProperties": {
    "^[0-9]+$": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string", "description": "The dialogue prompt" },
          "choices": {
            "type": "array",
            "items": { "type": "string" },
            "description": "List of string choices"
          },
          "correct": { "type": "integer", "description": "Zero-based index of the correct choice" }
        },
        "required": ["question", "choices", "correct"]
      }
    }
  }
}
